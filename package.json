{
  "name": "morphos-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @morphos/core build",
    "build:packages": "pnpm --filter './packages/**' build",
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "pnpm --filter @morphos/docs dev",
    "docs:build": "pnpm --filter @morphos/docs build",
    "docs:preview": "pnpm --filter @morphos/docs start",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx}": "eslint --fix"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^25.9.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@praxisjs/core": "^2.0.0",
    "@praxisjs/decorators": "^1.5.1",
    "@praxisjs/jsx": "^0.7.3",
    "@praxisjs/runtime": "^0.5.4",
    "@praxisjs/shared": "^0.3.1",
    "@praxisjs/vite-plugin": "^4.0.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
