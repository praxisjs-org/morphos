{
  "name": "@morphos/feedback",
  "version": "1.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/__tests__",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "praxisjs": {
    "optimize": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.2",
  "peerDependencies": {
    "@morphos/core": "workspace:*",
    "@praxisjs/core": ">=2.3.0",
    "@praxisjs/decorators": ">=2.0.0",
    "@praxisjs/jsx": ">=0.8.0",
    "@praxisjs/runtime": ">=0.8.0"
  },
  "devDependencies": {
    "@morphos/core": "workspace:*",
    "@praxisjs/core": "^2.3.0",
    "@praxisjs/decorators": "^2.0.0",
    "@praxisjs/jsx": "^0.8.1",
    "@praxisjs/runtime": "^0.8.1",
    "@praxisjs/shared": "^0.3.2",
    "typescript": "catalog:"
  }
}
