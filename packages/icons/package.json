{
  "name": "@morphos/icons",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    }
  },
  "packageManager": "pnpm@10.30.2",
  "peerDependencies": {
    "@morphos/core": "workspace:*",
    "@praxisjs/core": ">=1.0.0",
    "@praxisjs/decorators": ">=1.0.0",
    "@praxisjs/jsx": ">=0.5.0",
    "@praxisjs/runtime": ">=0.3.0",
    "lucide": ">=1.0.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@morphos/core": "workspace:*",
    "@praxisjs/core": "^2.0.0",
    "@praxisjs/decorators": "^1.5.1",
    "@praxisjs/jsx": "^0.7.3",
    "@praxisjs/runtime": "^0.5.4",
    "@praxisjs/shared": "^0.3.1",
    "lucide": "^1.27.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  }
}
